# Site configuration

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # only needed for trusted server-side admin operations

# ===== Cloudflare R2 =====
# Use the S3 API endpoint from Cloudflare R2.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public custom domain or public.dev URL for the bucket; no trailing slash.
# Keep this server-side (do not use NEXT_PUBLIC_).
R2_PUBLIC_BASE_URL=

# ===== Site =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
