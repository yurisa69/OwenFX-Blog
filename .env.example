# Site configuration

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required by trusted server-side integration endpoints. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Akismet comment spam protection =====
# Server-side API key only. Never add the NEXT_PUBLIC_ prefix.
AKISMET_API_KEY=

# ===== GitHub article content storage =====
# Fine-grained token with Contents: Read and write permission for this repository only.
# Keep this value server-side; never use a NEXT_PUBLIC_ prefix.
GITHUB_TOKEN=
GITHUB_REPOSITORY=yurisa69/OwenFX-Blog
GITHUB_BRANCH=main

# ===== Cloudflare R2 =====
# Use the S3 API endpoint from Cloudflare R2.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public custom domain or public.dev URL for the bucket; no trailing slash.
# Keep this server-side (do not use NEXT_PUBLIC_).
R2_PUBLIC_BASE_URL=

# ===== Site =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
